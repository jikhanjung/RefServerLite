# Environment Variables for RefServerLite
# Copy this file to .env and set your own values (OPTIONAL)

# Zotero API Key Encryption (OPTIONAL)
# If not set, a key will be automatically generated and saved to refdata/encryption.key
# Generate a new key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret and backup safely! If lost, all encrypted Zotero API keys will be unrecoverable.
# ZOTERO_ENCRYPTION_KEY=your_encryption_key_here

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: Disable ChromaDB telemetry
# CHROMA_TELEMETRY_DISABLED=1